",\"watchToken\":\"+\\\\\",\"csrfToken\":\"+\\\\\"});\n}];});});</script>\n<link rel=\"stylesheet\" href=\"/w/load.php?lang=en&amp;modules=ext.CookieWarning.styles%7Cext.DarkMode.styles%7Cext.MobileDetect.nomobile%7Cext.cite.styles%7Cext.embedVideo.styles%7Cext.visualEditor.desktopArticleTarget.noscript%7Cjquery.makeCollapsible.styles%7Cmediawiki.widgets.styles%7Coojs-ui-core.icons%2Cstyles%7Coojs-ui.styles.indicators%7Cskins.vector.styles.legacy&amp;only=styles&amp;skin=vector\">\n<script async=\"\" src=\"/w/load.php?lang=en&amp;modules=startup&amp;only=scripts&amp;raw=1&amp;skin=vector\"></script>\n<meta name=\"ResourceLoaderDynamicStyles\" content=\"\">\n<link rel=\"stylesheet\" href=\"/w/load.php?lang=en&amp;modules=site.styles&amp;only=styles&amp;skin=vector\">\n<meta name=\"generator\" content=\"MediaWiki 1.45.4\">\n<meta name=\"referrer\" content=\"origin\">\n<meta name=\"referrer\" content=\"origin-when-cross-origin\">\n<meta name=\"robots\" content=\"max-image-preview:standard\">\n<meta name=\"format-detection\" content=\"telephone=no\">\n<meta name=\"description\" content=\"The 1/256 miss glitch, also known as the Generation I miss, is a phenomenon in Pokémon Red, Blue, and Yellow, as well as the the Japanese exclusive Pokémon Stadium...\">\n<meta name=\"twitter:site\" content=\"\">\n<meta name=\"twitter:card\" content=\"summary\">\n<meta name=\"viewport\" content=\"width=1120\">\n<meta property=\"og:title\" content=\"1 in 256 miss glitch - Glitch City Wiki\">\n<meta property=\"og:type\" content=\"website\">\n<link rel=\"search\" type=\"application/opensearchdescription+xml\" href=\"/w/rest.php/v1/search\" title=\"Glitch City Wiki (en)\">\n<link rel=\"EditURI\" type=\"application/rsd+xml\" href=\"https://glitchcity.wiki/w/api.php?action=rsd\">\n<link rel=\"canonical\" href=\"https://glitchcity.wiki/wiki/1_in_256_miss_glitch\">\n<link rel=\"license\" href=\"https://creativecommons.org/licenses/by-nc/3.0\">\n<link rel=\"alternate\" type=\"application/atom+xml\" title=\"Glitch City Wiki Atom feed\" href=\"/wiki/Special:RecentChanges?feed=atom\">\n<link rel=\"dns-prefetch\" href=\"https://meta.miraheze.org\">\n<meta property=\"og:title\" content=\"1 in 256 miss glitch\">\n<meta property=\"og:site_name\" content=\"Glitch City Wiki\">\n<meta property=\"og:url\" content=\"https://glitchcity.wiki/wiki/1_in_256_miss_glitch\">\n<meta property=\"og:description\" content=\"The 1/256 miss glitch, also known as the Generation I miss, is a phenomenon in Pokémon Red, Blue, and Yellow, as well as the the Japanese exclusive Pokémon Stadium...\">\n<meta property=\"article:modified_time\" content=\"2026-09-06T04:48:01Z\">\n<meta property=\"article:published_time\" content=\"2026-09-06T04:48:01Z\">\n<script type=\"application/ld+json\">{\"@context\":\"http:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"1 in 256 miss glitch - Glitch City Wiki\",\"headline\":\"1 in 256 miss glitch - Glitch City Wiki\",\"mainEntityOfPage\":\"1 in 256 miss glitch\",\"identifier\":\"https:\\/\\/glitchcity.wiki\\/wiki\\/1_in_256_miss_glitch\",\"url\":\"https:\\/\\/glitchcity.wiki\\/wiki\\/1_in_256_miss_glitch\",\"description\":\"The 1\\/256 miss glitch, also known as the Generation I miss, is a phenomenon in Pok\\u00e9mon Red, Blue, and Yellow, as well as the the Japanese exclusive Pok\\u00e9mon Stadium...\",\"dateModified\":\"2026-09-06T04:48:01Z\",\"datePublished\":\"2026-09-06T04:48:01Z\",\"image\":{\"@type\":\"ImageObject\"},\"author\":{\"@type\":\"Organization\",\"name\":\"Glitch City Wiki\",\"url\":\"https:\\/\\/glitchcity.wiki\",\"logo\":{\"@type\":\"ImageObject\",\"caption\":\"Glitch City Wiki\"}},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Glitch City Wiki\",\"url\":\"https:\\/\\/glitchcity.wiki\",\"logo\":{\"@type\":\"ImageObject\",\"caption\":\"Glitch City Wiki\"}},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https:\\/\\/glitchcity.wiki\\/wiki\\/Special:Search?search={search_term}\",\"query-input\":\"required name=search_term\"}}</script>\n<link rel=\"dns-prefetch\" href=\"auth.miraheze.org\">\n</head>\n<body class=\"skin-vector-legacy mediawiki ltr sitedir-ltr mw-hide-empty-elt ns-0 ns-subject page-1_in_256_miss_glitch rootpage-1_in_256_miss_glitch skin-vector action-view\"><div id=\"mw-page-base\" class=\"noprint\"></div>\n<div id=\"mw-head-base\" class=\"noprint\"></div>\n<div id=\"content\" class=\"mw-body\" role=\"main\">\n\t<a id=\"top\"></a>\n\t<div id=\"siteNotice\"><!-- CentralNotice --></div>\n\t<div class=\"mw-indicators\">\n\t</div>\n\t<h1 id=\"firstHeading\" class=\"firstHeading mw-first-heading\"><span class=\"mw-page-title-main\">1 in 256 miss glitch</span></h1>\n\t<div id=\"bodyContent\" class=\"vector-body\">\n\t\t<div id=\"siteSub\" class=\"noprint\">From Glitch City Wiki</div>\n\t\t<div id=\"contentSub\"><div id=\"mw-content-subtitle\"></div></div>\n\t\t<div id=\"contentSub2\"></div>\n\t\t\n\t\t<div id=\"jump-to-nav\"></div>\n\t\t<a class=\"mw-jump-link\" href=\"#mw-head\">Jump to navigation</a>\n\t\t<a class=\"mw-jump-link\" href=\"#searchInput\">Jump to search</a>\n\t\t<div id=\"mw-content-text\" class=\"mw-body-content\"><div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p>The <b>1/256 miss glitch</b>, also known as the <b>Generation I miss</b>, is a phenomenon in <a href=\"/wiki/Pok%C3%A9mon_Red_and_Blue\" title=\"Pokémon Red and Blue\">Pokémon Red, Blue</a>, and <a href=\"/wiki/Pok%C3%A9mon_Yellow\" title=\"Pokémon Yellow\">Yellow</a>, as well as the the Japanese exclusive Pokémon Stadium \"Zero\", where moves will always have an additional 1/256 chance to miss, regardless of their accuracy.\n</p><p>The glitch is also present in Generation II, but is much more difficult to detect the presence of.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\"><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Cause\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Cause</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Fixes_in_other_Pokémon_games\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\">Fixes in other Pokémon games</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#In_Generation_II\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">In Generation II</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Video\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Video</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#See_also\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">See also</span></a></li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#Notes\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-7\"><a href=\"#Related_articles\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">Related articles</span></a></li>\n</ul>\n</div>\n\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Cause\">Cause</h2></div>\n<p>The accuracy of a move is stored as a 1-byte integer (i.e. in the range 0–255), where 255 corresponds to 100%. The calculated probability to hit is always represented as a 1-byte integer in the code (denoted <code>acc</code> below). The game then generates a random number (denoted <code>rng</code><i>)</i> in the range of 0-225. Then, the game performs a comparison with the <code>cp</code> instruction by computing <code>rng - acc</code>. If a negative number is returned (or when <code>acc &gt; rng</code>) the flag for the move to hit is set. Otherwise, the flag is unset and the move is considered to have missed. Therefore, a move will hit if the value of <code>rng</code> is <i>strictly less than</i> the value of <code>acc</code>.<sup id=\"cite_ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">[</span>note 1<span class=\"cite-bracket\">]</span></a></sup>\n</p><p>If <code>rng</code> randomly generates 255, it is impossible for <code>acc</code> to be greater than <code>rng</code>, because such a larger number cannot exist in a single byte. As such, when 255 is generated by the game's rng, the move will always miss regardless of its accuracy. \n</p><p>All moves with an accuracy check are impacted by this glitch. However, the glitch's occurrence can only be noticed when using 100% accurate moves, as they're meant to never miss. It is otherwise indistinguishable from the accuracy check failing as intended. \n</p><p>Certain moves bypass the accuracy check completely and thus cannot miss even through this glitch, such as <a href=\"https://bulbapedia.bulbagarden.net/wiki/Swift\" class=\"extiw\" title=\"bp:Swift\">Swift</a> or moves under the effect of <a href=\"https://bulbapedia.bulbagarden.net/wiki/X_Accuracy\" class=\"extiw\" title=\"bp:X Accuracy\">X Accuracy</a>. \n</p><p>In circumstances where glitches are banned, such as in some speedrun categories, this glitch is rarely banned. It is out of the player's control and more likely to be to the player's detriment should the glitch occur.<sup id=\"cite_ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">[</span>note 2<span class=\"cite-bracket\">]</span></a></sup> <a rel=\"nofollow\" class=\"external text\" href=\"https://tasvideos.org/Glossary#ToolAssistedSpeedrunTas\">TASes</a> using a glitchless ruleset tend to abuse the glitch using <a href=\"/wiki/Luck_manipulation\" title=\"Luck manipulation\">RNG manipulation</a> for significant time saves. However, this makes the overall manipulation route to force all rare events the creator of a TAS may want much more difficult.    \n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Fixes_in_other_Pokémon_games\"><span id=\"Fixes_in_other_Pok.C3.A9mon_games\"></span>Fixes in other Pokémon games</h3></div>\n<p>The glitch is partly patched in the international releases of <a href=\"/wiki/Pok%C3%A9mon_Stadium?action=edit&amp;redlink=1\" class=\"new\" title=\"Pokémon Stadium (page does not exist)\">Pokémon Stadium</a>. If <code>rng</code> is 255, the game will instead generate a new random number. However, if this new number is also 255, then a Generation I miss will still occur as the game will not try regenerating the number again. Thus, a Gen I miss has a 1/65536 (or ~0.0015%) chance of occurring in Pokemon Stadium.\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"In_Generation_II\">In Generation II</h2></div>\n<p>The 1 in 256 miss glitch is fixed in <a href=\"/wiki/Pok%C3%A9mon_Gold_and_Silver\" title=\"Pokémon Gold and Silver\">Pokémon Gold, Silver</a> and <a href=\"/wiki/Pok%C3%A9mon_Crystal\" title=\"Pokémon Crystal\">Crystal</a> in such a way that mitigates its effect significantly.\n</p><p>In the routine for moves, the game checks if the value of the move's <code>acc</code> calculates to 255 after modifiers are applied. If this is true, the game does not generate any random number for an accuracy check and instead registers a hit. As a result, the 1/256 glitch may only occur in moves that already have a chance to miss. Therefore, while an instance of an inaccurate move missing may be a 1 in 256 miss, it is impossible to tell if the move missed when it was supposed to or because the random number rolled is equal to the accuracy. Those moves are expected to miss some of the time, and so the effect this has on gameplay is minimized.\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Video\">Video</h2></div>\n<table align=\"center\" style=\"border-radius: 10px; -moz-border-radius: 10px; -webkit-border-radius: 10px; -khtml-border-radius: 10px; -icab-border-radius: 10px; -o-border-radius: 10px; border: 2px solid #828282; background: #cccccc;\">\n<tbody><tr>\n<td width=\"425px\" colspan=\"2\"><center>\n<p class=\"mw-empty-elt\"></p><figure class=\"embedvideo\" data-service=\"youtube\" data-mw-iframeconfig=\"{&quot;width&quot;:420,&quot;height&quot;:238,&quot;src&quot;:&quot;https://www.youtube-nocookie.com/embed/KF6Icb9JYns?autoplay=1&quot;}\" style=\"width:420px\">\n\t<div class=\"embedvideo-wrapper\" style=\"height:238px\">\n\t\t<div class=\"embedvideo-consent\" data-show-privacy-notice=\"1\">\n\t<div class=\"embedvideo-overlay\">\n\t\t<div class=\"embedvideo-loader\" role=\"button\">\n\t\t\t<div class=\"embedvideo-loader__fakeButton\">Load video</div>\n\t\t\t<div class=\"embedvideo-loader__footer\">\n\t\t\t\t<div class=\"embedvideo-loader__service\">YouTube</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"embedvideo-privacyNotice hidden\">\n\t\t\t<div class=\"embedvideo-privacyNotice__content\">YouTube might collect personal data. <a href=\"https://www.youtube.com/howyoutubeworks/privacy/\" rel=\"nofollow,noopener\" target=\"_blank\" class=\"embedvideo-privacyNotice__link\">Privacy Policy</a></div>\n\t\t\t<div class=\"embedvideo-privacyNotice__buttons\">\n\t\t\t\t<button class=\"embedvideo-privacyNotice__continue\">Continue</button>\n\t\t\t\t<button class=\"embedvideo-privacyNotice__dismiss\">Dismiss</button>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n\t</div>\n</figure>\n\n<p class=\"mw-empty-elt\"></p>\n</center>\n</td></tr>\n<tr>\n<td width=\"425px\" colspan=\"2\" style=\"line-height:10px\"><center><b><a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/watch?v=KF6Icb9JYns\">YouTube video by Werster</a></b></center>\n</td></tr>\n</tbody></table>\n<p><br>\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"See_also\">See also</h2></div>\n<ul><li><a href=\"/wiki/Swift_miss_glitch\" title=\"Swift miss glitch\">Swift miss glitch</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Notes\">Notes</h2></div>\n<div class=\"mw-references-wrap\"><ol class=\"references\" data-mw-group=\"note\">\n<li id=\"cite_note-1\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-1\">↑</a></span> <span class=\"reference-text\">From <a rel=\"nofollow\" class=\"external text\" href=\"https://github.com/pret/pokered/blob/70228c2c4a94a8079d5d465c802d4f0159caa592/engine/battle/core.asm#L5451-L5455\">this block of code</a> in the disassembly project.  Thanks to CasualPokePlayer for the explanation.</span>\n</li>\n<li id=\"cite_note-2\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-2\">↑</a></span> <span class=\"reference-text\">Overall the player makes more moves than the opponent does, and so is statistically more likely to experience at least one of their moves missing because of the 1/256 glitch.</span>\n</li>\n</ol></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Related_articles\">Related articles</h2></div>\n<div style=\"border: 1px solid #000000; padding: .5em 1em 1.5em; color: #000000; background-color: #FFFFFF; margin: 3px 3px 0; text-align: center\"><b><a href=\"/wiki/Category:Generation_I_natural_glitches\" title=\"Category:Generation I natural glitches\">Natural glitches </a></b> in <b><a href=\"/wiki/Pok%C3%A9mon_Red_and_Blue\" title=\"Pokémon Red and Blue\">Pokémon Red, Blue</a>, and <a href=\"/wiki/Pok%C3%A9mon_Yellow\" title=\"Pokémon Yellow\">Yellow</a><br></b> <div style=\"padding: 2px\" class=\"toccolours mw-collapsible mw-collapsed\"><br>\n<p><span style=\"font-size:14px\"><a href=\"/wiki/A-Button_held_down_glitches\" title=\"A-Button held down glitches\">A-Button held down glitches</a> ∣\n<a href=\"/wiki/Bicycle_music_hole_glitch\" title=\"Bicycle music hole glitch\">Bicycle music hole glitch</a> ∣\n<a href=\"/wiki/Bike_Shop_instant_text_glitch\" title=\"Bike Shop instant text glitch\">Bike Shop instant text glitch</a> ∣\n<a href=\"/wiki/Cable_Club_Glitch_City_transition\" title=\"Cable Club Glitch City transition\">Cable Club Glitch City transition</a> ∣\n<a href=\"/wiki/Cycling_Road_sign_glitch\" title=\"Cycling Road sign glitch\">Cycling Road sign glitch</a> ∣\n<a href=\"/wiki/Disabling_NPC_animations_glitch\" title=\"Disabling NPC animations glitch\">Disabling NPC animations glitch</a> ∣\n<a href=\"/wiki/Escape_sprite_handling_glitch\" title=\"Escape sprite handling glitch\">Escape sprite handling glitch</a> ∣\n<a href=\"/wiki/Evolving_Raichu_localization_error\" title=\"Evolving Raichu localization error\">Evolving Raichu localization error</a> <b>(International red and blue)</b> ∣\n<a href=\"/wiki/Invisible_tree_glitch\" title=\"Invisible tree glitch\">Invisible tree</a> ∣\n<a href=\"/wiki/Item_jingle_skip_glitch\" title=\"Item jingle skip glitch\">Item jingle skip</a> ∣\n<a href=\"/wiki/Landing_on_an_NPC\" title=\"Landing on an NPC\">Landing on an NPC</a> ∣\n<a href=\"/wiki/Mr._Fuji%27s_house_door_glitch\" title=\"Mr. Fuji's house door glitch\">Mr. Fuji's house door glitch</a> ∣\n<a href=\"/wiki/NPC_collision_bypassing_glitch\" title=\"NPC collision bypassing glitch\">NPC collision bypassing</a> ∣\n<a href=\"/wiki/Professor_Oak%27s_lab_music_glitch\" title=\"Professor Oak's lab music glitch\">Professor Oak's lab music glitch</a> ∣\n<a href=\"/wiki/Professor_Oak%27s_lab_tilemap_corruption_glitch\" title=\"Professor Oak's lab tilemap corruption glitch\">Professor Oak's lab tilemap corruption glitch</a> ∣\n<a href=\"/wiki/Trainer_Card_transition_screens\" title=\"Trainer Card transition screens\">Trainer Card transition screens</a> ∣\n<a href=\"/wiki/Unidentified_ghost_still_registers_seen\" title=\"Unidentified ghost still registers seen\">Unidentified ghost still registers seen</a> ∣\n<a href=\"/wiki/Vending_machine_purchase_glitch\" title=\"Vending machine purchase glitch\">Vending machine purchase glitch</a>\n</span></p>\n<hr>\n<p><b>Classes:</b><br>\n<a href=\"/wiki/Category:Battle_glitches_(Generation_I)\" title=\"Category:Battle glitches (Generation I)\">Battle glitches</a> ∣\n<a href=\"/wiki/Category:Move_glitches_(Generation_I)\" 